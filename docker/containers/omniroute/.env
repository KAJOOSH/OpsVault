# ============================================================
# OmniRoute Docker Configuration
# ============================================================

# Node.js heap limit in MB.
# 1024 is a practical starting point for Codex workloads.
OMNIROUTE_MEMORY_MB=1024

# 32-byte / 64-hex-character encryption key.
# Generate before first startup.
STORAGE_ENCRYPTION_KEY=CHANGE_ME

# Strong random secret used by the Codex Responses WS bridge.
OMNIROUTE_WS_BRIDGE_SECRET=CHANGE_ME
